        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Email address"
          },
          "chain-id": {
            "type": "string",
            "description": "Optional registration chain override for new accounts"
          }
        },
        "required": [
          "email"
        ],
        "additionalProperties": true
      }
    },
