[
  {
    "id": 1,
    "name": "乾",
    "full": "乾为天",
    "pinyin": "qián wéi tiān",
    "text": "元，亨，利，贞。\n天行健，\n君子以自强不息。",
    "lines": [
      1,
      1,
      1,
      1,
      1,
      1
    ],
    "name_pinyin": "Qian"
  },
  {
    "id": 2,
    "name": "坤",
    "full": "坤为地",
    "pinyin": "kūn wéi dì",
    "text": "元，亨，利，牝马之贞。\n君子有攸往，\n先迷后得，主利。\n西南得朋，东北丧朋。\n安贞吉。\n地势坤，君子以厚德载物。",
    "lines": [
      0,
      0,
      0,
      0,
      0,
      0
    ],
    "name_pinyin": "Kun"
  },
  {
    "id": 3,
    "name": "屯",
    "full": "水雷屯",
    "pinyin": "shuǐ léi zhūn",
    "text": "元，亨，利贞。\n勿用有攸往，利建侯。\n云雷，屯。君子以经纶。",
    "lines": [
      1,
      0,
      0,
      0,
      1,
      0
    ],
    "name_pinyin": "Zhun"
  },
  {
    "id": 4,
    "name": "蒙",
    "full": "山水蒙",
    "pinyin": "shān shuǐ méng",
    "text": "亨。匪我求童蒙，\n童蒙求我。\n初筮告，再三渎，\n渎则不告。\n利贞。山下出泉，蒙。\n君子以果行育德。",
    "lines": [
      0,
      1,
      0,
      0,
      0,
      1
    ],
    "name_pinyin": "Meng"
  },
  {
    "id": 5,
    "name": "需",
    "full": "水天需",
    "pinyin": "shuǐ tiān xū",
    "text": "有孚，光亨，贞吉。\n利涉大川。\n云上于天，需。\n君子以饮食宴乐。",
    "lines": [
      1,
      1,
      1,
      0,
      1,
      0
    ],
    "name_pinyin": "Xu"
  },
  {
    "id": 6,
    "name": "讼",
    "full": "天水讼",
    "pinyin": "tiān shuǐ sòng",
    "text": "有孚，窒惕，中吉，\n终凶。\n利见大人，不利涉大川。\n天与水违行，讼。\n君子以作事谋始。",
    "lines": [
      0,
      1,
      0,
      1,
      1,
      1
    ],
    "name_pinyin": "Song"
  },
  {
    "id": 7,
    "name": "师",
    "full": "地水师",
    "pinyin": "dì shuǐ shī",
    "text": "贞，丈人吉，无咎。\n地中有水，师。\n君子以容民畜众。",
    "lines": [
      0,
      1,
      0,
      0,
      0,
      0
    ],
    "name_pinyin": "Shi"
  },
  {
    "id": 8,
    "name": "比",
    "full": "水地比",
    "pinyin": "shuǐ dì bǐ",
    "text": "吉。原筮元永贞，\n无咎。\n不宁方来，后夫凶。\n地上有水，比。\n先王以建万国，亲诸侯。",
    "lines": [
      0,
      0,
      0,
      0,
      1,
      0
    ],
    "name_pinyin": "Bi"
  },
  {
    "id": 9,
    "name": "小畜",
    "full": "风天小畜",
    "pinyin": "fēng tiān xiǎo chù",
    "text": "亨。密云不雨，\n自我西郊。\n风行天上，小畜。\n君子以懿文德。",
    "lines": [
      1,
      1,
      1,
      0,
      1,
      1
    ],
    "name_pinyin": "Xiaoxu"
  },
  {
    "id": 10,
    "name": "履",
    "full": "天泽履",
    "pinyin": "tiān zé lǚ",
    "text": "虎尾，不咥人，\n亨。\n上天下泽，履。\n君子以辨上下，\n定民志。",
    "lines": [
      1,
      1,
      0,
      1,
      1,
      1
    ],
    "name_pinyin": "Lv"
  },
  {
    "id": 11,
    "name": "泰",
    "full": "地天泰",
    "pinyin": "dì tiān tài",
    "text": "小往大来，吉亨。\n天地交，泰。\n后以财成天地之道，\n辅相天地之宜，\n以左右民。",
    "lines": [
      1,
      1,
      1,
      0,
      0,
      0
    ],
    "name_pinyin": "Tai"
  },
  {
    "id": 12,
    "name": "否",
    "full": "天地否",
    "pinyin": "tiān dì pǐ",
    "text": "否之匪人，不利君子贞，\n大往小来。\n天地不交，否。\n君子以俭德辟难，\n不可荣以禄。",
    "lines": [
      0,
      0,
      0,
      1,
      1,
      1
    ],
    "name_pinyin": "Pi"
  },
  {
    "id": 13,
    "name": "同人",
    "full": "天火同人",
    "pinyin": "tiān huǒ tóng rén",
    "text": "同人于野，亨。\n利涉大川。\n利君子贞。\n天与火，同人。\n君子以类族辨物。",
    "lines": [
      1,
      0,
      1,
      1,
      1,
      1
    ],
    "name_pinyin": "Tongren"
  },
  {
    "id": 14,
    "name": "大有",
    "full": "火天大有",
    "pinyin": "huǒ tiān dà yǒu",
    "text": "元亨。\n火在天上，大有。\n君子以遏恶扬善，\n顺天休命。",
    "lines": [
      1,
      1,
      1,
      1,
      0,
      1
    ],
    "name_pinyin": "Dayou"
  },
  {
    "id": 15,
    "name": "谦",
    "full": "地山谦",
    "pinyin": "dì shān qiān",
    "text": "亨。君子有终。\n地中有山，谦。\n君子以裒多益寡，\n称物平施。",
    "lines": [
      0,
      0,
      1,
      0,
      0,
      0
    ],
    "name_pinyin": "Qian"
  },
  {
    "id": 16,
    "name": "豫",
    "full": "雷地豫",
    "pinyin": "léi dì yù",
    "text": "利建侯行师。\n雷出地奋，豫。\n先王以作乐崇德，\n殷荐之上帝，以配祖考。",
    "lines": [
      0,
      0,
      0,
      1,
      0,
      0
    ],
    "name_pinyin": "Yu"
  },
  {
    "id": 17,
    "name": "随",
    "full": "泽雷随",
    "pinyin": "zé léi suí",
    "text": "元亨，利贞，无咎。\n泽中有雷，随。\n君子以向晦入宴息。",
    "lines": [
      1,
      0,
      0,
      1,
      1,
      0
    ],
    "name_pinyin": "Sui"
  },
  {
    "id": 18,
    "name": "蛊",
    "full": "山风蛊",
    "pinyin": "shān fēng gǔ",
    "text": "元亨，利涉大川。\n先甲三日，后甲三日。\n山下有风，蛊。\n君子以振民育德。",
    "lines": [
      0,
      1,
      1,
      0,
      0,
      1
    ],
    "name_pinyin": "Gu"
  },
  {
    "id": 19,
    "name": "临",
    "full": "泽地临",
    "pinyin": "zé dì lín",
    "text": "元亨利贞。\n至于八月有凶。\n泽上有地，临。\n君子以教思无穷，\n容保民无疆。",
    "lines": [
      0,
      0,
      0,
      1,
      1,
      0
    ],
    "name_pinyin": "Lin"
  },
  {
    "id": 20,
    "name": "观",
    "full": "地风观",
    "pinyin": "dì fēng guān",
    "text": "盥而不荐，有孚颙若。\n风行地上，观。\n先王以省方，观民设教。",
    "lines": [
      0,
      1,
      1,
      0,
      0,
      0
    ],
    "name_pinyin": "Guan"
  },
  {
    "id": 21,
    "name": "噬嗑",
    "full": "火雷噬嗑",
    "pinyin": "huǒ léi shì kè",
    "text": "亨。利用狱。\n雷电，噬嗑。\n先王以明罚敕法。",
    "lines": [
      1,
      0,
      0,
      1,
      0,
      1
    ],
    "name_pinyin": "Shike"
  },
  {
    "id": 22,
    "name": "贲",
    "full": "山火贲",
    "pinyin": "shān huǒ bì",
    "text": "亨。小利有攸往。\n山下有火，贲。\n君子以明庶政，无敢折狱。",
    "lines": [
      1,
      0,
      1,
      0,
      0,
      1
    ],
    "name_pinyin": "Bi"
  },
  {
    "id": 23,
    "name": "剥",
    "full": "山地剥",
    "pinyin": "shān dì bō",
    "text": "不利有攸往。\n山附于地，剥。\n上以厚下，安宅。",
    "lines": [
      0,
      0,
      0,
      0,
      0,
      1
    ],
    "name_pinyin": "Bo"
  },
  {
    "id": 24,
    "name": "复",
    "full": "地雷复",
    "pinyin": "dì léi fù",
    "text": "亨。出入无疾，朋来无咎。\n反复其道，七日来复，\n利有攸往。\n雷在地中，复。\n先王以至日闭关，\n商旅不行，后不省方。",
    "lines": [
      1,
      0,
      0,
      0,
      0,
      0
    ],
    "name_pinyin": "Fu"
  },
  {
    "id": 25,
    "name": "无妄",
    "full": "天雷无妄",
    "pinyin": "tiān léi wú wàng",
    "text": "元亨利贞。\n其匪正有眚，不利有攸往。\n天下雷行，物与无妄。\n先王以茂对时育万物。",
    "lines": [
      1,
      0,
      0,
      1,
      1,
      1
    ],
    "name_pinyin": "Wuwang"
  },
  {
    "id": 26,
    "name": "大畜",
    "full": "山天大畜",
    "pinyin": "shān tiān dà xù",
    "text": "利贞。不家食吉，利涉大川。\n天在山中，大畜。\n君子以多识前言往行，\n以畜其德。",
    "lines": [
      1,
      1,
      1,
      0,
      0,
      1
    ],
    "name_pinyin": "Daxu"
  },
  {
    "id": 27,
    "name": "颐",
    "full": "山雷颐",
    "pinyin": "shān léi yí",
    "text": "贞吉。\n观颐，自求口实。\n山下有雷，颐。\n君子以慎言语，节饮食。",
    "lines": [
      1,
      0,
      0,
      0,
      0,
      1
    ],
    "name_pinyin": "Yi"
  },
  {
    "id": 28,
    "name": "大过",
    "full": "泽风大过",
    "pinyin": "zé fēng dà guò",
    "text": "栋桡。利有攸往，亨。\n泽灭木，大过。\n君子以独立不惧，遁世无闷。",
    "lines": [
      0,
      1,
      1,
      1,
      1,
      0
    ],
    "name_pinyin": "Daguo"
  },
  {
    "id": 29,
    "name": "坎",
    "full": "坎为水",
    "pinyin": "kǎn wéi shuǐ",
    "text": "习坎。\n有孚，维心亨，行有尚。\n水洊至，习坎。\n君子以常德行，习教事。",
    "lines": [
      0,
      1,
      0,
      0,
      1,
      0
    ],
    "name_pinyin": "Kan"
  },
  {
    "id": 30,
    "name": "离",
    "full": "离为火",
    "pinyin": "lí wéi huǒ",
    "text": "利贞，亨。\n畜牝牛吉。\n明两作，离。\n大人以继明照于四方。",
    "lines": [
      1,
      0,
      1,
      1,
      0,
      1
    ],
    "name_pinyin": "Li"
  },
  {
    "id": 31,
    "name": "咸",
    "full": "泽山咸",
    "pinyin": "zé shān xián",
    "text": "亨，利贞。\n取女吉。山上有泽，咸。\n君子以虚受人。",
    "lines": [
      0,
      0,
      1,
      1,
      1,
      0
    ],
    "name_pinyin": "Xian"
  },
  {
    "id": 32,
    "name": "恒",
    "full": "雷风恒",
    "pinyin": "léi fēng héng",
    "text": "亨，无咎，利贞。\n利有攸往。雷风，恒。\n君子以立不易方。",
    "lines": [
      0,
      1,
      1,
      1,
      0,
      0
    ],
    "name_pinyin": "Heng"
  },
  {
    "id": 33,
    "name": "遯",
    "full": "天山遯",
    "pinyin": "tiān shān dùn",
    "text": "亨。小利贞。\n天下有山，遯。\n君子以远小人，不恶而严。",
    "lines": [
      0,
      0,
      1,
      1,
      1,
      1
    ],
    "name_pinyin": "Dun"
  },
  {
    "id": 34,
    "name": "大壮",
    "full": "雷天大壮",
    "pinyin": "léi tiān dà zhuàng",
    "text": "利贞。\n雷在天上，大壮。\n君子以非礼勿履。",
    "lines": [
      1,
      1,
      1,
      1,
      0,
      0
    ],
    "name_pinyin": "Dazhuang"
  },
  {
    "id": 35,
    "name": "晋",
    "full": "火地晋",
    "pinyin": "huǒ dì jìn",
    "text": "康侯用锡马蕃庶，\n昼日三接。\n明出地上，晋。\n君子以自昭明德。",
    "lines": [
      0,
      0,
      0,
      1,
      0,
      1
    ],
    "name_pinyin": "Jin"
  },
  {
    "id": 36,
    "name": "明夷",
    "full": "地火明夷",
    "pinyin": "dì huǒ míng yí",
    "text": "利艰贞。\n明入地中，明夷。\n君子以莅众，用晦而明。",
    "lines": [
      1,
      0,
      1,
      0,
      0,
      0
    ],
    "name_pinyin": "Mingyi"
  },
  {
    "id": 37,
    "name": "家人",
    "full": "风火家人",
    "pinyin": "fēng huǒ jiā rén",
    "text": "利女贞。\n风自火出，家人。\n君子以言有物，而行有恒。",
    "lines": [
      1,
      0,
      1,
      0,
      1,
      1
    ],
    "name_pinyin": "Jiaren"
  },
  {
    "id": 38,
    "name": "睽",
    "full": "火泽睽",
    "pinyin": "huǒ zé kuí",
    "text": "小事吉。\n上火下泽，睽。\n君子以同而异。",
    "lines": [
      1,
      1,
      0,
      1,
      0,
      1
    ],
    "name_pinyin": "Kui"
  },
  {
    "id": 39,
    "name": "蹇",
    "full": "水山蹇",
    "pinyin": "shuǐ shān jiǎn",
    "text": "利西南，不利东北。\n利见大人，贞吉。\n山上有水，蹇。\n君子以反身修德。",
    "lines": [
      0,
      0,
      1,
      0,
      1,
      0
    ],
    "name_pinyin": "Jian"
  },
  {
    "id": 40,
    "name": "解",
    "full": "雷水解",
    "pinyin": "léi shuǐ xiè",
    "text": "利西南。\n无所往，其来复吉。\n有攸往，夙吉。\n雷雨作，解。\n君子以赦过宥罪。",
    "lines": [
      0,
      1,
      0,
      1,
      0,
      0
    ],
    "name_pinyin": "Xie"
  },
  {
    "id": 41,
    "name": "损",
    "full": "山泽损",
    "pinyin": "shān zé sǔn",
    "text": "有孚，元吉，无咎。\n可贞。利有攸往。\n山下有泽，损。\n君子以惩忿窒欲。",
    "lines": [
      1,
      1,
      0,
      0,
      0,
      1
    ],
    "name_pinyin": "Sun"
  },
  {
    "id": 42,
    "name": "益",
    "full": "风雷益",
    "pinyin": "fēng léi yì",
    "text": "利有攸往，利涉大川。\n风雷，益。\n君子以见善则迁，\n有过则改。",
    "lines": [
      1,
      0,
      0,
      0,
      1,
      1
    ],
    "name_pinyin": "Yi"
  },
  {
    "id": 43,
    "name": "夬",
    "full": "泽天夬",
    "pinyin": "zé tiān guài",
    "text": "扬于王庭，孚号有厉。\n告自邑，不利即戎。\n利有攸往。\n泽上于天，夬。\n君子以施禄及下，居德则忌。",
    "lines": [
      1,
      1,
      1,
      1,
      1,
      0
    ],
    "name_pinyin": "Guai"
  },
  {
    "id": 44,
    "name": "姤",
    "full": "天风姤",
    "pinyin": "tiān fēng gòu",
    "text": "女壮，勿用取女。\n天下有风，姤。\n后以施命诰四方。",
    "lines": [
      0,
      1,
      1,
      1,
      1,
      1
    ],
    "name_pinyin": "Gou"
  },
  {
    "id": 45,
    "name": "萃",
    "full": "泽地萃",
    "pinyin": "zé dì cuì",
    "text": "亨。王假有庙，利见大人，\n亨。利贞。\n用大牲吉，利有攸往。\n泽上于地，萃。\n君子以除戎器，戒不虞。",
    "lines": [
      0,
      0,
      0,
      1,
      1,
      0
    ],
    "name_pinyin": "Cui"
  },
  {
    "id": 46,
    "name": "升",
    "full": "地风升",
    "pinyin": "dì fēng shēng",
    "text": "元亨。用见大人。\n勿恤。南征吉。\n地中生木，升。\n君子以顺德，积小以高大。",
    "lines": [
      0,
      1,
      1,
      0,
      0,
      0
    ],
    "name_pinyin": "Sheng"
  },
  {
    "id": 47,
    "name": "困",
    "full": "泽水困",
    "pinyin": "zé shuǐ kùn",
    "text": "亨。贞。大人吉，\n无咎。有言不信。\n泽无水，困。\n君子以致命遂志。",
    "lines": [
      0,
      1,
      0,
      1,
      1,
      0
    ],
    "name_pinyin": "Kun"
  },
  {
    "id": 48,
    "name": "井",
    "full": "水风井",
    "pinyin": "shuǐ fēng jǐng",
    "text": "改邑不改井，无丧无得，\n往来井井。汔至，\n亦未繘井，羸其瓶，凶。\n木上有水，井。\n君子以劳民劝相。",
    "lines": [
      0,
      1,
      1,
      0,
      1,
      0
    ],
    "name_pinyin": "Jing"
  },
  {
    "id": 49,
    "name": "革",
    "full": "泽火革",
    "pinyin": "zé huǒ gé",
    "text": "己日乃孚。\n元亨利贞。悔亡。\n泽中有火，革。\n君子以治历明时。",
    "lines": [
      1,
      0,
      1,
      1,
      1,
      0
    ],
    "name_pinyin": "Ge"
  },
  {
    "id": 50,
    "name": "鼎",
    "full": "火风鼎",
    "pinyin": "huǒ fēng dǐng",
    "text": "元吉，亨。\n木上有火，鼎。\n君子以正位凝命。",
    "lines": [
      0,
      1,
      1,
      1,
      0,
      1
    ],
    "name_pinyin": "Ding"
  },
  {
    "id": 51,
    "name": "震",
    "full": "震为雷",
    "pinyin": "zhèn wéi léi",
    "text": "亨。震来虩虩，\n笑言哑哑。\n震惊百里，不丧匕鬯。\n洊雷，震。\n君子以恐惧修省。",
    "lines": [
      1,
      0,
      0,
      1,
      0,
      0
    ],
    "name_pinyin": "Zhen"
  },
  {
    "id": 52,
    "name": "艮",
    "full": "艮为山",
    "pinyin": "gèn wéi shān",
    "text": "其背，不获其身；\n行其庭，不见其人，\n无咎。兼山，艮。\n君子以思不出其位。",
    "lines": [
      0,
      0,
      1,
      0,
      0,
      1
    ],
    "name_pinyin": "Gen"
  },
  {
    "id": 53,
    "name": "渐",
    "full": "风山渐",
    "pinyin": "fēng shān jiàn",
    "text": "女归吉。\n利贞。山上有木，渐。\n君子以居贤德，善俗。",
    "lines": [
      0,
      0,
      1,
      0,
      1,
      1
    ],
    "name_pinyin": "Jian"
  },
  {
    "id": 54,
    "name": "归妹",
    "full": "雷泽归妹",
    "pinyin": "léi zé guī mèi",
    "text": "征凶。无攸利。\n泽上有雷，归妹。\n君子以终始有常。",
    "lines": [
      1,
      1,
      0,
      1,
      0,
      0
    ],
    "name_pinyin": "Guimei"
  },
  {
