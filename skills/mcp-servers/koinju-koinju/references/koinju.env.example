# Koinju credentials — fill in below, save, then `chmod 600 .koinju.env`.
# Do NOT commit this file. (`.gitignore` excludes it by default.)
#
# Don't have credentials yet? Sign up at https://koinju.io/pricing —
# Koinju emails you a link to https://dataroom.koinju.io/ where the
# REST API key and ClickHouse host / user / password live.

# REST API key (used by /ohlcv, /trade, /funding-rate, /volatility-index, /stats):
export KOINJU_API_KEY=

# ClickHouse SQL access.
#
# IMPORTANT: KOINJU_DB_HOST is the BARE HOSTNAME — NO https:// scheme, NO port,
# NO trailing slash. clickhouse-connect adds the scheme/port itself.
#
#   Correct:   KOINJU_DB_HOST=abc123.koinju.io
#              KOINJU_DB_HOST=your-cluster.clickhouse.cloud
#
#   Wrong:     KOINJU_DB_HOST=https://abc123.koinju.io       (strip https://)
#              KOINJU_DB_HOST=abc123.koinju.io:8443           (port belongs in KOINJU_DB_PORT)
#              KOINJU_DB_HOST=https://abc123.koinju.io:8443/  (strip both, and the trailing /)
#
# The dataroom often shows the full https://host:port URL — copy the hostname only.
export KOINJU_DB_HOST=
export KOINJU_DB_USER=
export KOINJU_DB_PASSWORD=

# Optional overrides (defaults: 8443 / api):
# export KOINJU_DB_PORT=8443
# export KOINJU_DB_DATABASE=api
