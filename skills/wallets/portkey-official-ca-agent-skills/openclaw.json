{
  "name": "ca-agent-skills",
  "description": "AI Agent toolkit for Portkey Wallet on aelf blockchain",
  "tools": [
    {
      "name": "portkey-query-check-account",
      "description": "Check if an email is registered in Portkey",
      "command": "bun run portkey_query_skill.ts check-account",
      "args": [
        "--email"
      ],
      "cwd": ".",
      "inputSchema": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Email address"
          }
        },
        "required": [
          "email"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "portkey-query-guardian-list",
      "description": "Get guardian list for an account on an explicit chain",
      "command": "bun run portkey_query_skill.ts guardian-list",
      "args": [
        "--identifier",
        "--chain-id"
      ],
      "cwd": ".",
      "inputSchema": {
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string",
            "description": "Guardian identifier"
          },
          "chain-id": {
            "type": "string",
            "description": "Explicit chain ID"
          }
        },
        "required": [
          "identifier",
          "chain-id"
        ],
        "additionalProperties": true
      }
    },
    {
