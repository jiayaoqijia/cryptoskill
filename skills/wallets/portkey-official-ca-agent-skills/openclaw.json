    {
      "name": "portkey-auth-save-keystore",
      "description": "Encrypt and save Manager wallet to keystore file (~/.portkey/ca/)",
      "command": "bun run portkey_auth_skill.ts save-keystore",
      "args": [
        "--password",
        "--private-key",
        "--mnemonic",
        "--ca-hash",
        "--ca-address",
        "--login-email",
        "--origin-chain-id"
      ],
      "cwd": ".",
      "inputSchema": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string",
            "description": "Password to encrypt the keystore"
          },
          "private-key": {
            "type": "string",
            "description": "Manager private key"
          },
          "mnemonic": {
            "type": "string",
            "description": "Manager mnemonic"
          },
          "ca-hash": {
            "type": "string",
            "description": "CA hash"
          },
          "ca-address": {
            "type": "string",
            "description": "CA address"
          },
          "login-email": {
            "type": "string",
            "description": "Login email associated with this CA account"
          },
          "origin-chain-id": {
            "type": "string",
            "description": "Resolved origin chain ID from prepare-auth-flow"
          }
        },
        "required": [
          "password",
          "private-key",
          "mnemonic",
          "ca-hash",
          "ca-address",
          "origin-chain-id"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "portkey-auth-recover-and-save",
      "description": "Recover an existing CA wallet, wait for pass status, and immediately save the new manager to a reusable local keystore.",
      "command": "bun run portkey_auth_skill.ts recover-and-save",
      "args": [
        "--email",
        "--guardians-approved",
        "--chain-id",
        "--password",
        "--login-email"
      ],
      "cwd": ".",
      "inputSchema": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Email address to recover"
          },
          "guardians-approved": {
            "type": "string",
            "description": "JSON array of approved guardians"
          },
          "chain-id": {
            "type": "string",
            "description": "Resolved chain ID from prepare-auth-flow"
          },
          "password": {
            "type": "string",
            "description": "Password to encrypt the reusable keystore"
          },
          "login-email": {
            "type": "string",
            "description": "Optional profile email to persist with the recovered keystore"
          }
        },
        "required": [
          "email",
          "guardians-approved",
          "chain-id",
          "password"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "portkey-auth-unlock",
      "description": "Unlock the encrypted keystore with a password. If the password was forgotten, use recover-and-save to re-login / recover with fresh guardian verification codes.",
      "command": "bun run portkey_auth_skill.ts unlock",
      "args": [
        "--password",
        "--login-email",
        "--keystore-file"
      ],
      "cwd": ".",
