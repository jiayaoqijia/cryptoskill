#!/usr/bin/env bash
set -euo pipefail

task_dir="${1:-}"
[ -n "$task_dir" ] || { echo "usage: create-harness-runner <task-dir>" >&2; exit 2; }
mkdir -p "$task_dir"
task_dir="$(cd "$task_dir" && pwd)"

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
resolve_harness_q="$(printf '%q' "$script_dir/resolve-harness")"
runner="$task_dir/mm-harness"

{
printf '#!/usr/bin/env bash\n'
printf 'set -euo pipefail\n'
printf 'RESOLVE_HARNESS=%s\n' "$resolve_harness_q"
cat <<'EOF'
DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
HARNESS="$("$RESOLVE_HARNESS" "$DIR" --verify-only)" || exit $?
exec "$HARNESS" "$@"
EOF
} > "$runner"
chmod +x "$runner"
printf '%s\n' "$runner"
