        "type": "object",
        "properties": {
          "password": {
            "type": "string",
            "description": "Keystore password"
          },
          "login-email": {
            "type": "string",
            "description": "Login email associated with this CA account"
          },
          "keystore-file": {
            "type": "string",
            "description": "Explicit keystore file path"
          }
        },
        "required": [
          "password"
        ],
        "additionalProperties": true
      }
    },
