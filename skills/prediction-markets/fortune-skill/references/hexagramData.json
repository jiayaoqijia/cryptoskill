    "name": "巽",
    "full": "巽为风",
    "pinyin": "xùn wéi fēng",
    "text": "小亨。\n利有攸往，利见大人。\n随风，巽。\n君子以申命行事。",
    "lines": [
      0,
      1,
      1,
      0,
      1,
      1
    ],
    "name_pinyin": "Xun"
  },
